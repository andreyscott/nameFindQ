# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret. Used for AI write-backs and quota bookkeeping.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Postgres (Project Settings → Database → Connection pooling, port 6543) ────
# Use the pooler URL on serverless (Vercel / Alibaba FC).
DATABASE_URL=postgresql://postgres.your-ref:<password>@aws-0-region.pooler.supabase.com:6543/postgres

# ── Qwen / Alibaba DashScope ──────────────────────────────────────────────────
QWEN_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Site ──────────────────────────────────────────────────────────────────────
# Public base URL, used for OAuth redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
